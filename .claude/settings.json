{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.backup*)",
      "Read(.env.production*)",
      "Read(.env.development*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(db-backups/**)"
    ]
  }
}
