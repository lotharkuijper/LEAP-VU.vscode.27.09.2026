# LEAP-VU: alle omgevingsvariabelen die de server, de frontend en de scripts lezen.
# Kopieer naar .env en vul in. Commit .env NOOIT (de repo is openbaar).
# Op Azure staan de geheimen in Key Vault kv-vu-leap; azure/scripts/deploy.sh zet ze
# op de Container App. Lokaal tegen Azure: `node azure/scripts/local-env.mjs` vult de
# Supabase-waarden hieronder voor je in.
# Regels die met "# " beginnen zijn optioneel; laat ze weg als je de standaard wilt.

# ── Supabase (inloggen, database-API, opslag) ───────────────────────────────────
# Publiek adres van Supabase (op Azure: de vu-leap-supabase Container App).
# Komt ook in de frontendbundel; de server gebruikt het voor de service-role-client.
VITE_PUBLIC_SUPABASE_URL=https://supabase.example.invalid
# Publieke anon-sleutel (komt in de frontendbundel; geen geheim, wel per omgeving).
VITE_PUBLIC_SUPABASE_ANON_KEY=
# "off" op Azure: geen Supabase Realtime, schermen verversen periodiek (src/lib/liveUpdates.ts).
VITE_PUBLIC_REALTIME=off
# Zelfde adres en sleutel onder de naam die /api/health en de check-/eval-scripts lezen.
SUPABASE_URL=https://supabase.example.invalid
SUPABASE_ANON_KEY=
# GEHEIM. Service-role-sleutel: omzeilt alle RLS-regels. Alleen op de server.
SUPABASE_SERVICE_ROLE_KEY=
# GEHEIM. Directe Postgres-verbinding (pgPool, migraties, atomaire chunk-opslag).
SUPABASE_DB_URL=postgres://user:password@db.example.invalid:5432/postgres

# ── Azure OpenAI (VU-resource, EU) — nooit de publieke OpenAI ───────────────────
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com
# GEHEIM.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Naam van de chat-deployment; dit bepaalt welk model antwoordt.
AZURE_OPENAI_DEPLOYMENT=
# Naam van de embedding-deployment. Bewust geen standaard: zonder deze waarde geven
# upload, RAG-zoeken en begrippenextractie een 503.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optioneel: eigen api-version voor embeddings (standaard gelijk aan AZURE_OPENAI_API_VERSION).
# AZURE_OPENAI_EMBEDDING_API_VERSION=
# Modelnaam voor de parameterkeuze (bv. reasoning-model of niet). Routeert NIET.
OPENAI_MODEL=

# ── App-server ──────────────────────────────────────────────────────────────────
# Poort van de Express-server (standaard 3001; API_PORT is een oudere naam).
# PORT=3001
# API_PORT=
# Publiek adres van de app, voor links in e-mails (bv. https://leap.vu-edulab.nl).
APP_BASE_URL=http://localhost:5000
APP_PUBLIC_URL=http://localhost:5000
# "true" op Azure: voer nieuwe migraties uit bij het starten (scripts/migrate.mjs --on-start).
# MIGRATE_ON_START=true
# "production" in de container; "test" schakelt caches en de poort uit in tests.
# NODE_ENV=
# Pad naar LibreOffice als het niet in het PATH staat (documentviewer, paginanummers).
# SOFFICE_BIN=soffice
# GEHEIM, optioneel. Sleutel voor ondertekende tutorbeurten en uitnodigingslinks.
# Zonder: afgeleid van SUPABASE_SERVICE_ROLE_KEY.
# LEAP_TURN_SECRET=
# Hoe lang inlogcontrole en profiel onthouden worden (ms, standaard 30000).
# LEAP_AUTH_CACHE_MS=30000
# Domeinen die niet via open registratie mogen (kommagescheiden, standaard vu.nl).
# OPEN_REG_BLOCKED_DOMAINS=vu.nl
# Tijdklokken van het Studiecafé (ms).
# STUDIECAFE_DIGEST_INTERVAL_MS=
# STUDIECAFE_READS_CLEANUP_INTERVAL_MS=
# Website-import: hartslag van de voortgang en pauze tussen pagina's (ms).
# WEB_IMPORT_HEARTBEAT_MS=
# WEB_IMPORT_PAGE_PACING_MS=

# ── E-mail ──────────────────────────────────────────────────────────────────────
# GEHEIM. Gedeeld geheim met GoTrue voor de account-e-mails (/api/auth/email-hook).
AUTH_EMAIL_HOOK_SECRET=
# Azure Communication Services (op Azure). GEHEIM: de connection string.
# ACS_CONNECTION_STRING=
# ACS_SENDER=leap@example.invalid
# Adres waar antwoorden op LEAP-mails heen gaan.
# MAIL_REPLY_TO=
# Resend (alternatief buiten Azure). GEHEIM: de API-sleutel.
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=

# ── Canvas (LTI 1.3) — zonder deze waarden weigert de koppeling netjes ──────────
# JSON-lijst van platforms: [{"issuer":"…","clientId":"…","deploymentIds":["…"],"authUrl":"…","jwksUrl":"…"}]
# LTI_PLATFORMS=
# Of één platform met losse variabelen:
# LTI_ISSUER=
# LTI_CLIENT_ID=
# LTI_DEPLOYMENT_IDS=
# LTI_AUTH_URL=
# LTI_JWKS_URL=
# GEHEIM. Privésleutel van LEAP (maak met: node scripts/lti-keygen.mjs).
# LTI_TOOL_PRIVATE_JWK=
# Publiek adres voor de LTI-routes, als dat afwijkt van APP_BASE_URL.
# LTI_APP_URL=

# ── ShareStats-vraagbank (GitHub) ───────────────────────────────────────────────
# GEHEIM, optioneel. Token om ShareStats-inhoud van GitHub te halen (hogere limiet).
# GITHUB_TOKEN=
# SHARESTATS_OWNER=
# SHARESTATS_REPO=
# SHARESTATS_BRANCH=

# ── Alleen voor scripts (niet nodig voor de app) ────────────────────────────────
# Adres van de draaiende API voor check-/eval-scripts (standaard http://localhost:3001).
# LEAP_API_URL=
# CHECK_API=
# Testaccount en adres voor de schermcontrole (npm run ui:audit, scripts/ui-audit-account.mjs).
# UI_AUDIT_BASE=http://localhost:5000
# UI_AUDIT_EMAIL=
# UI_AUDIT_PASSWORD=
# Cursus(sen) voor de metingen tegen het echte model.
# EVAL_COURSE_ID=
# EVAL_COURSES=
# EVAL_LANG=
# EVAL_QUESTION=
# EVAL_EARLY=
# EVAL_LATE=
# EVAL_LATE_TERMS=
# EVAL_CONCURRENCY=
# EVAL_EFFORT_GEN=
# EVAL_EFFORT_VERIFY=
# EVAL_PRICE_IN=
# EVAL_PRICE_OUT=
# Oudere leerniveau-metingen (scripts/eval-learning-levels*.js).
# CHAT_EVAL_BASE_URL=
# CHAT_EVAL_TOKEN=
# PERSONA_EVAL_BASE_URL=
# PERSONA_EVAL_TOKEN=
# PERSONA_EVAL_GROUP_ID=
# PERSONA_EVAL_PERSONA_ID=
# PERSONA_PROMPT=
# LEVELS=
# QUESTION=
# REASONING_EFFORT=
# Documentviewer-controle (scripts/check-document-viewer.mjs).
# VIEWER_QUESTION=
# VIEWER_CHOICE_TESTID=
# VIEWER_SHOT=
# Vertaalscripts (i18n-generate, server-i18n-generate).
# LANGS=fr,de
# BATCH=
# CONCURRENCY=
# TIME_BUDGET_MS=
# MAX_TOKENS=
# FETCH_TIMEOUT_MS=
# Ander .env-bestand voor azure/scripts/local-env.mjs.
# LEAP_ENV_FILE=
# Lokale testdatabase (scripts/local-db): andere containernaam, poort of image.
# LOCAL_DB_NAME=leap-localdb
# LOCAL_DB_PORT=54329
# PG_IMAGE=
# Azure-beheerscripts (azure/scripts/*.sh): Postgres-clienttools, bron/doel bij overzetten.
# PGBIN=
# SOURCE_URL=
# SOURCE_KEY=
# TARGET_URL=
# TARGET_KEY=
# BESTAANDE_INHOUD_OK=

# ── Niet (meer) gebruiken ───────────────────────────────────────────────────────
# OPENAI_API_KEY      oud; de code leest hem nog maar gebruikt hem niet (alleen /api/health toont of hij bestaat).
# VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY   oude namen; enkele scripts vallen er nog op terug.
